; WorldClaw Mobil — Godot 4 loyihasi
; Galaxy S26 Ultra uchun mobil Vulkan renderer bilan.
; Editorda ochish: Godot 4.3+ (Import -> shu papka).

config_version=5

[application]

config/name="WorldClaw Mobil"
config/description="Promptdan qurilma ichida 3D dunyo generatsiyasi."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "Mobile")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1080
window/size/viewport_height=1920
window/handheld/orientation=1
window/stretch/mode="canvas_items"

[rendering]

; Mobil Vulkan yo'li — Snapdragon Adreno GPU uchun.
renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
textures/vram_compression/import_etc2_astc=true

[input_devices]

pointing/emulate_touch_from_mouse=true
